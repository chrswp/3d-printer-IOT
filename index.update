                { id: 39, name: "Arabica Takengon", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 40, name: "Arabica Temanggung", category: "Local Arabica", price_per_kg: 360000, stock_gram: 500 }, 
                { id: 41, name: "Arabica Toraja Kalosi", category: "Local Arabica", price_per_kg: 300000, stock_gram: 300 }, 
                { id: 42, name: "Arabica Toraja Pulu-Pulu", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 43, name: "Classic Home Blend", category: "Blend", price_per_kg: 300000, stock_gram: 0 },
                { id: 44, name: "Espresso", category: "Blend", price_per_kg: 260000, stock_gram: 0 },
                { id: 45, name: "Honey Bali", category: "Honey", price_per_kg: 400000, stock_gram: 0 },
                { id: 46, name: "Honey Flores", category: "Honey", price_per_kg: 400000, stock_gram: 0 },
                { id: 47, name: "Honey Gayo", category: "Honey", price_per_kg: 400000, stock_gram: 0 },
                { id: 48, name: "Honey Halu", category: "Honey", price_per_kg: 400000, stock_gram: 0 },
                { id: 49, name: "Honey Red", category: "Honey", price_per_kg: 420000, stock_gram: 0 },
                { id: 50, name: "Honey Sunda Gulali", category: "Honey", price_per_kg: 420000, stock_gram: 0 },
                { id: 51, name: "Honey Tarlos", category: "Honey", price_per_kg: 400000, stock_gram: 0 },
                { id: 52, name: "Natural Bali", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 53, name: "Natural Banana", category: "Natural", price_per_kg: 470000, stock_gram: 0 },
                { id: 54, name: "Natural Flores", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 55, name: "Natural Garut", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 56, name: "Natural Gayo", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 57, name: "Natural Ijen", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 58, name: "Natural Kamojang", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 59, name: "Natural Patuha", category: "Natural", price_per_kg: 420000, stock_gram: 0 },
                { id: 60, name: "Natural Red", category: "Natural", price_per_kg: 420000, stock_gram: 0 },
                { id: 61, name: "Natural Tarlos", category: "Natural", price_per_kg: 400000, stock_gram: 0 },
                { id: 62, name: "Natural Y. Anggur", category: "Natural", price_per_kg: 420000, stock_gram: 0 },
                { id: 63, name: "Natural Y. Borbon", category: "Natural", price_per_kg: 420000, stock_gram: 0 },
                { id: 64, name: "Natural Y. Datura", category: "Natural", price_per_kg: 420000, stock_gram: 0 },
                { id: 65, name: "Arabica Garut Wine", category: "Wine", price_per_kg: 470000, stock_gram: 0 },
                { id: 66, name: "Arabica Gayo Wine L/M/Dark", category: "Wine", price_per_kg: 470000, stock_gram: 0 },
                { id: 67, name: "Arabica Puntang Wine", category: "Wine", price_per_kg: 470000, stock_gram: 0 },
                { id: 68, name: "Arabica Brazil Honey", category: "Import", price_per_kg: 520000, stock_gram: 0 },
                { id: 69, name: "Arabica Colombia", category: "Import", price_per_kg: 520000, stock_gram: 0 },
                { id: 70, name: "Arabica Guatemala", category: "Import", price_per_kg: 520000, stock_gram: 0 },
                { id: 71, name: "Arabica Bluemount.", category: "Specialty", price_per_kg: 470000, stock_gram: 0 },
                { id: 72, name: "Arabica Exotis Anaerob Jagong Jeget", category: "Specialty", price_per_kg: 420000, stock_gram: 0 },
                { id: 73, name: "Arabica Geisha", category: "Specialty", price_per_kg: 470000, stock_gram: 0 },
                { id: 74, name: "Arabica Luwak", category: "Specialty", price_per_kg: 620000, stock_gram: 0 },
                { id: 75, name: "Arabica Puntang Honey", category: "Specialty", price_per_kg: 920000, stock_gram: 0 },
                { id: 76, name: "Excelsa Ijen", category: "Excelsa", price_per_kg: 340000, stock_gram: 0 },
                { id: 77, name: "Liberica Jambi", category: "Liberica", price_per_kg: 340000, stock_gram: 0 },
                { id: 78, name: "Robusta Malang", category: "Robusta", price_per_kg: 150000, stock_gram: 1250 }
            ];

            for (const p of defaultProducts) {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', p.id.toString());
                await setDoc(docRef, p);
            }
        }

        function formatIDR(num) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
        }

        window.switchTab = function(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-amber-50', 'text-amber-900');
                el.classList.add('text-gray-600');
            });

            document.getElementById(`sec-${tabName}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabName}`);
            activeBtn.classList.add('bg-amber-50', 'text-amber-900');

            if(tabName === 'pos') { window.renderPOSProducts(); window.renderCustomerSelect(); }
            if(tabName === 'incoming') window.renderIncomingOptions();
            if(tabName === 'opnam') window.renderOpnam();
            if(tabName === 'customers') window.renderCustomers();
            if(tabName === 'history') window.renderHistory();
            if(tabName === 'reports') window.renderReports();
        }

        // ================= KASIR (POS) =================
        window.renderCustomerSelect = function() {
            const custSelect = document.getElementById('pos-customer-select');
            custSelect.innerHTML = '<option value="">-- Umum / Tanpa Nama --</option>' + 
                customers.map(c => `<option value="${c.id}">${c.name} (${c.phone})</option>`).join('');
        }

        window.renderPOSProducts = function() {
            const search = document.getElementById('pos-search').value.toLowerCase();
            const cat = document.getElementById('pos-category-filter').value;
            const container = document.getElementById('pos-product-list');

            const filtered = products.filter(p => {
                const matchName = p.name.toLowerCase().includes(search);
                const matchCat = cat === 'ALL' || p.category === cat;
                return matchName && matchCat;
            });

            container.innerHTML = filtered.map(p => `
                <div class="border rounded-lg p-3 bg-white shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-[9px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-bold">${p.category}</span>
                        </div>
                        
                        <!-- Input Edit Nama Produk -->
                        <div class="mb-1.5">
                            <label class="text-[10px] text-gray-500 font-semibold block">Nama Item:</label>
                            <input type="text" id="name-input-${p.id}" value="${p.name}" class="border p-1 rounded text-xs w-full font-bold text-gray-800 bg-gray-50 focus:bg-white">
                        </div>

                        <!-- Input Edit Harga per Kg -->
                        <div class="mb-2 flex items-center gap-1">
                            <label class="text-[10px] text-gray-500 font-semibold whitespace-nowrap">Harga/kg:</label>
                            <input type="number" id="price-input-${p.id}" value="${p.price_per_kg}" step="1000" class="border p-1 rounded text-xs w-full font-semibold text-amber-900 bg-gray-50 focus:bg-white">
                            <button onclick="window.updateProductInfo(${p.id})" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] px-2 py-1 rounded font-medium whitespace-nowrap">Simpan</button>
                        </div>

                        <p class="text-xs ${p.stock_gram > 0 ? 'text-emerald-600' : 'text-red-500'} font-semibold">Stok: ${p.stock_gram} gr</p>
                    </div>

                    <!-- Tombol Pilihan Kemasan yang Disusun Rapi (100g, 200g, 250g, 500g, 1kg) -->
                    <div class="mt-3 grid grid-cols-5 gap-1 pt-2 border-t border-gray-100">
                        <button onclick="window.addToCart(${p.id}, 100)" class="bg-amber-800 text-white text-[10px] py-1.5 rounded hover:bg-amber-700 font-bold transition">100g</button>
                        <button onclick="window.addToCart(${p.id}, 200)" class="bg-amber-800 text-white text-[10px] py-1.5 rounded hover:bg-amber-700 font-bold transition">200g</button>
                        <button onclick="window.addToCart(${p.id}, 250)" class="bg-amber-800 text-white text-[10px] py-1.5 rounded hover:bg-amber-700 font-bold transition">250g</button>
                        <button onclick="window.addToCart(${p.id}, 500)" class="bg-amber-800 text-white text-[10px] py-1.5 rounded hover:bg-amber-700 font-bold transition">500g</button>
                        <button onclick="window.addToCart(${p.id}, 1000)" class="bg-amber-900 text-white text-[10px] py-1.5 rounded hover:bg-amber-800 font-bold transition">1kg</button>
                    </div>
                </div>
            `).join('');
        }

        window.updateProductInfo = async function(productId) {
            if (!currentUser) return;
            const newName = document.getElementById(`name-input-${productId}`).value.trim();
            const newPrice = parseInt(document.getElementById(`price-input-${productId}`).value);

            if (!newName) {
                alert('Nama produk tidak boleh kosong!');
                return;
            }
            if (isNaN(newPrice) || newPrice < 0) {
                alert('Masukkan nominal harga yang valid!');
                return;
            }

            try {
                const prodRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', productId.toString());
                await updateDoc(prodRef, { 
                    name: newName,
                    price_per_kg: newPrice 
                });
                alert('Nama dan harga produk berhasil diperbarui secara real-time ke seluruh sistem!');
            } catch (err) {
                console.error(err);
                alert('Gagal memperbarui produk.');
            }
        }

        window.addToCart = function(productId, qtyGram) {
            const prod = products.find(p => p.id === productId);
            if (!prod || prod.stock_gram < qtyGram) {
                alert('Stok tidak mencukupi atau habis!');
                return;
            }

            const existing = cart.find(c => c.productId === productId);
            if (existing) {
                if(prod.stock_gram < existing.qtyGram + qtyGram) {
                    alert('Stok tidak mencukupi untuk ditambah lagi!');
                    return;
                }
                existing.qtyGram += qtyGram;
            } else {
                cart.push({ productId, qtyGram, price_per_kg: prod.price_per_kg, name: prod.name });
            }
            window.renderCart();
        }

        window.renderCart = function() {
            const container = document.getElementById('cart-items');
            let total = 0;

            if (cart.length === 0) {
                container.innerHTML = '<p class="text-xs text-gray-400 text-center py-4">Keranjang kosong</p>';
                document.getElementById('cart-total').innerText = formatIDR(0);
                return;
            }

            container.innerHTML = cart.map((item, index) => {
                const subtotal = (item.qtyGram / 1000) * item.price_per_kg;
                total += subtotal;
                return `
                    <div class="pt-2 flex justify-between items-center text-xs">
                        <div>
                            <p class="font-bold text-gray-700">${item.name}</p>
                            <p class="text-gray-400">${item.qtyGram} gram x ${formatIDR(item.price_per_kg)}</p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold">${formatIDR(subtotal)}</p>
                            <button onclick="window.removeFromCart(${index})" class="text-red-500 hover:underline text-[10px]">Hapus</button>
                        </div>
                    </div>
                `;
            }).join('');

            document.getElementById('cart-total').innerText = formatIDR(total);
        }

        window.removeFromCart = function(index) {
            cart.splice(index, 1);
            window.renderCart();
        }

        window.checkout = async function() {
            if (cart.length === 0) return alert('Keranjang belanja kosong!');
            if (!currentUser) return alert('Gagal memproses, koneksi cloud terputus.');

            const btnCheckout = document.getElementById('btn-checkout');
            btnCheckout.innerText = "Memproses...";
            btnCheckout.disabled = true;

            try {
                const custId = document.getElementById('pos-customer-select').value;
                const customer = customers.find(c => c.id == custId) || { name: 'Umum' };
                
                let totalAmount = 0;
                
                for (const item of cart) {
                    const prod = products.find(p => p.id === item.productId);
                    if (prod) {
                        const newStock = prod.stock_gram - item.qtyGram;
                        const prodRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', prod.id.toString());
                        await updateDoc(prodRef, { stock_gram: newStock });
                    }
                    totalAmount += (item.qtyGram / 1000) * item.price_per_kg;
                }

                const saleId = Date.now().toString();
                const newSale = {
                    id: saleId,
                    invoice: 'INV-' + Math.floor(100000 + Math.random() * 900000),
                    date: new Date().toISOString(),
                    customerName: customer.name,
                    items: [...cart],
                    totalAmount: totalAmount
                };

                const saleRef = doc(db, 'artifacts', appId, 'public', 'data', 'sales', saleId);
                await setDoc(saleRef, newSale);

                window.printInvoice(newSale);

                cart = [];
                window.renderCart();

            } catch (err) {
                console.error(err);
                alert('Terjadi kesalahan saat sinkronisasi data!');
            } finally {
                btnCheckout.innerText = "Proses Transaksi";
                btnCheckout.disabled = false;
            }
        }

        window.printInvoice = function(sale) {
            document.getElementById('inv-no').innerText = sale.invoice;
            document.getElementById('inv-date').innerText = new Date(sale.date).toLocaleString('id-ID');
            document.getElementById('inv-cust').innerText = sale.customerName || 'Umum';
            
            const invBody = document.getElementById('inv-items');
            invBody.innerHTML = sale.items.map(item => {
                const subtotal = (item.qtyGram / 1000) * item.price_per_kg;
                return `
                    <tr>
                        <td class="py-1.5 pr-1 font-medium">${item.name}</td>
                        <td class="py-1.5 px-1 text-center">${item.qtyGram}g</td>
                        <td class="py-1.5 px-1 text-right">${formatIDR(item.price_per_kg)}</td>
                        <td class="py-1.5 pl-1 text-right font-bold">${formatIDR(subtotal)}</td>
                    </tr>
                `;
            }).join('');
            
            document.getElementById('inv-total').innerText = formatIDR(sale.totalAmount);

            const invoiceElem = document.getElementById('printable-invoice');
            invoiceElem.classList.remove('hidden');

            setTimeout(() => {
                window.print();
                invoiceElem.classList.add('hidden');
            }, 300);
        }

        // ================= STOK MASUK (INCOMING) =================
        window.renderIncomingOptions = function() {
            const searchVal = (document.getElementById('incoming-search').value || "").toLowerCase();
            const select = document.getElementById('incoming-product');
            
            const filtered = products.filter(p => p.name.toLowerCase().includes(searchVal));
            
            if (filtered.length === 0) {
                select.innerHTML = '<option value="">-- Kopi tidak ditemukan --</option>';
                return;
            }

            select.innerHTML = filtered.map(p => `<option value="${p.id}">${p.name} (Stok: ${p.stock_gram} gr)</option>`).join('');
        }

        window.handleIncoming = async function(e) {
            e.preventDefault();
            if (!currentUser) return;
            const prodId = document.getElementById('incoming-product').value;
            if (!prodId) return alert('Silakan pilih produk terlebih dahulu.');
            const qty = parseInt(document.getElementById('incoming-qty').value);

            const prod = products.find(p => p.id.toString() === prodId);
            if (prod) {
                const newStock = prod.stock_gram + qty;
                const prodRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', prod.id.toString());
                await updateDoc(prodRef, { stock_gram: newStock });
                
                alert(`Stok ${prod.name} tersinkronisasi ke Cloud! (+${qty} gr)`);
                document.getElementById('incoming-form').reset();
                window.renderIncomingOptions();
            }
        }

        // ================= STOCK OPNAM (DENGAN SEARCH) =================
        window.renderOpnam = function() {
            const searchVal = (document.getElementById('opnam-search')?.value || "").toLowerCase();
            const tbody = document.getElementById('opnam-table-body');
            
            const filtered = products.filter(p => p.name.toLowerCase().includes(searchVal) || p.category.toLowerCase().includes(searchVal));

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-gray-400">Tidak ada produk ditemukan</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(p => `
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-2 border font-medium">${p.name}</td>
                    <td class="p-2 border">${p.category}</td>
                    <td class="p-2 border font-bold text-amber-900">${p.stock_gram} gr</td>
                    <td class="p-2 border">
                        <input type="number" id="opnam-input-${p.id}" value="${p.stock_gram}" class="border p-1 rounded w-28 text-sm">
                    </td>
                    <td class="p-2 border">
                        <button onclick="window.updateOpnam(${p.id})" class="bg-amber-800 text-white text-xs px-2 py-1 rounded">Sinkronisasi Update</button>
                    </td>
                </tr>
            `).join('');
        }

        window.updateOpnam = async function(productId) {
            if (!currentUser) return;
            const val = parseInt(document.getElementById(`opnam-input-${productId}`).value);
            if (isNaN(val) || val < 0) return alert('Masukkan angka stok yang valid!');
            
            const prod = products.find(p => p.id === productId);
            if (prod) {
                const prodRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', productId.toString());
                await updateDoc(prodRef, { stock_gram: val });
                alert(`Stok ${prod.name} berhasil diperbarui di seluruh perangkat!`);
            }
        }

        // ================= CUSTOMERS =================
        window.renderCustomers = function() {
            const tbody = document.getElementById('customer-table-body');
            tbody.innerHTML = customers.map(c => `
                <tr class="border-b">
                    <td class="p-2 border font-medium">${c.name}</td>
                    <td class="p-2 border">${c.phone}</td>
                    <td class="p-2 border">${c.address}</td>
                </tr>
            `).join('');
        }

        window.handleAddCustomer = async function(e) {
            e.preventDefault();
            if (!currentUser) return;
            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            const address = document.getElementById('cust-address').value;

            const newCustId = Date.now().toString();
            const newCust = { id: newCustId, name, phone, address };
            
            const custRef = doc(db, 'artifacts', appId, 'public', 'data', 'customers', newCustId);
            await setDoc(custRef, newCust);
            
            document.getElementById('customer-form').reset();
        }

        // ================= HISTORI =================
        window.renderHistory = function() {
            const tbody = document.getElementById('history-table-body');
            tbody.innerHTML = sales.map(s => `
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-2 border font-mono font-bold">${s.invoice}</td>
                    <td class="p-2 border">${new Date(s.date).toLocaleString('id-ID')}</td>
                    <td class="p-2 border">${s.customerName}</td>
                    <td class="p-2 border font-bold">${formatIDR(s.totalAmount)}</td>
                    <td class="p-2 border flex gap-1">
                        <button onclick='window.printInvoice(${JSON.stringify(s)})' class="bg-gray-700 hover:bg-gray-800 text-white text-xs px-2 py-1 rounded">Cetak</button>
                        <button onclick='window.deleteSale("${s.id}")' class="bg-red-600 hover:bg-red-700 text-white text-xs px-2 py-1 rounded">Hapus</button>
                    </td>
                </tr>
            `).join('');
        }

        window.deleteSale = async function(saleId) {
            if (!currentUser) return alert('Koneksi cloud terputus.');
            
            if (!confirm('Apakah Anda yakin ingin menghapus transaksi ini? Stok kopi yang terjual akan otomatis dikembalikan ke sistem.')) {
                return;
            }

            try {
                const sale = sales.find(s => s.id === saleId);
                if (!sale) return;

                for (const item of sale.items) {
                    const prod = products.find(p => p.id === item.productId);
                    if (prod) {
                        const newStock = prod.stock_gram + item.qtyGram;
                        const prodRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', prod.id.toString());
                        await updateDoc(prodRef, { stock_gram: newStock });
                    }
                }

                const saleRef = doc(db, 'artifacts', appId, 'public', 'data', 'sales', saleId);
                await deleteDoc(saleRef);

                alert('Data transaksi berhasil dihapus dari cloud dan stok telah dikembalikan.');
            } catch (err) {
                console.error("Error menghapus transaksi: ", err);
                alert('Gagal menghapus transaksi. Periksa koneksi internet Anda.');
            }
        }

        // ================= REPORTS =================
        window.renderReports = function() {
            let totalOmset = 0;
            let totalWeight = 0;

            sales.forEach(s => {
                totalOmset += s.totalAmount;
                s.items.forEach(i => totalWeight += i.qtyGram);
            });

            document.getElementById('stat-omset').innerText = formatIDR(totalOmset);
            document.getElementById('stat-count').innerText = sales.length;
            document.getElementById('stat-weight').innerText = `${totalWeight} gr`;

            const ctx = document.getElementById('salesChart').getContext('2d');
            const salesByDate = {};
            
            [...sales].reverse().forEach(s => {
                const dateKey = new Date(s.date).toLocaleDateString('id-ID');
                salesByDate[dateKey] = (salesByDate[dateKey] || 0) + s.totalAmount;
            });

            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Object.keys(salesByDate),
                    datasets: [{
                        label: 'Omset Penjualan (Rp)',
                        data: Object.values(salesByDate),
                        borderColor: '#78350f',
                        backgroundColor: 'rgba(120, 53, 15, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: { responsive: true, plugins: { legend: { display: true } } }
            });
        }
    </script>
</body>
</html>


