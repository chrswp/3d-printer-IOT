```h
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>POS Gentan Kopi - Realtime Cloud</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @media print {
            body { background: #ffffff !important; margin: 0 !important; padding: 0 !important; color: #000000 !important; }
            header, aside, main, nav, button, .no-print { display: none !important; }
            #printable-invoice { display: block !important; position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 10px; }
            #printable-invoice table { width: 100%; border-collapse: collapse; }
        }
    </style>
</head>
<body class="bg-gray-100 font-sans antialiased">

    <!-- Header / Navbar -->
    <header class="bg-amber-900 text-white shadow-md no-print">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-700 p-2 rounded-full font-bold text-xl">☕</div>
                <div>
                    <h1 class="text-xl font-bold leading-none">Gentan Kopi POS</h1>
                    <span class="text-xs text-amber-200" id="sync-status">Menghubungkan ke Cloud...</span>
                </div>
            </div>
        </div>
    </header>

    <div class="container mx-auto px-2 md:px-4 py-4 flex flex-col md:flex-row gap-4 no-print">

        <!-- Navigation Sidebar -->
        <aside class="w-full md:w-1/5 bg-white rounded-lg shadow p-3 h-fit">
            <nav class="grid grid-cols-2 md:grid-cols-1 gap-1">
                <button onclick="window.switchTab('pos')" id="tab-pos" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-amber-900 bg-amber-50 text-xs md:text-sm">🛒 Kasir</button>
                <button onclick="window.switchTab('incoming')" id="tab-incoming" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-gray-600 hover:bg-amber-50 text-xs md:text-sm">📦 Stok Masuk</button>
                <button onclick="window.switchTab('opnam')" id="tab-opnam" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-gray-600 hover:bg-amber-50 text-xs md:text-sm">📋 Opnam</button>
                <button onclick="window.switchTab('customers')" id="tab-customers" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-gray-600 hover:bg-amber-50 text-xs md:text-sm">👥 Pelanggan</button>
                <button onclick="window.switchTab('history')" id="tab-history" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-gray-600 hover:bg-amber-50 text-xs md:text-sm">📜 Histori</button>
                <button onclick="window.switchTab('reports')" id="tab-reports" class="tab-btn w-full text-left px-3 py-2 rounded-md font-medium text-gray-600 hover:bg-amber-50 text-xs md:text-sm">📊 Laporan</button>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="w-full md:w-4/5">

            <!-- TAB 1: KASIR (POS) -->
            <section id="sec-pos" class="tab-content grid grid-cols-1 lg:grid-cols-3 gap-4">
                <div class="lg:col-span-2 bg-white p-4 rounded-lg shadow">
                    <h2 class="text-base font-bold mb-3 text-gray-800">Pilih Produk Kopi & Pengaturan Master</h2>
                    <div class="flex flex-col sm:flex-row gap-2 mb-3">
                        <input type="text" id="pos-search" onkeyup="window.renderPOSProducts()" placeholder="Cari kopi..." class="border p-2 rounded w-full text-xs md:text-sm">
                        <select id="pos-category-filter" onchange="window.renderPOSProducts()" class="border p-2 rounded text-xs md:text-sm">
                            <option value="ALL">Semua Kategori</option>
                            <option value="Local Arabica">Local Arabica</option>
                            <option value="Robusta">Robusta</option>
                            <option value="Blend">Blend</option>
                            <option value="Honey">Honey</option>
                            <option value="Natural">Natural</option>
                            <option value="Wine">Wine</option>
                            <option value="Import">Import</option>
                            <option value="Specialty">Specialty</option>
                            <option value="Excelsa">Excelsa</option>
                            <option value="Liberica">Liberica</option>
                        </select>
                    </div>
                    <div id="pos-product-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[550px] overflow-y-auto pr-1"></div>
                </div>

                <div class="bg-white p-4 rounded-lg shadow flex flex-col justify-between">
                    <div>
                        <h2 class="text-base font-bold mb-3 text-gray-800">Keranjang Belanja</h2>
                        <div class="mb-3">
                            <label class="block text-[11px] font-semibold text-gray-600 mb-1">Pelanggan</label>
                            <select id="pos-customer-select" class="border p-2 rounded w-full text-xs md:text-sm">
                                <option value="">-- Umum / Tanpa Nama --</option>
                            </select>
                        </div>
                        <div id="cart-items" class="space-y-2 max-h-[280px] overflow-y-auto mb-3 divide-y">
                            <p class="text-xs text-gray-400 text-center py-4">Keranjang kosong</p>
                        </div>
                    </div>
                    <div class="border-t pt-3">
                        <div class="flex justify-between font-bold text-base mb-3">
                            <span>Total:</span>
                            <span id="cart-total" class="text-amber-900">Rp0</span>
                        </div>
                        <button onclick="window.checkout()" id="btn-checkout" class="w-full bg-amber-900 hover:bg-amber-800 text-white py-2.5 rounded font-bold shadow text-sm">Proses Transaksi</button>
                    </div>
                </div>
            </section>

            <!-- TAB 2: STOK MASUK -->
            <section id="sec-incoming" class="tab-content hidden bg-white p-5 rounded-lg shadow">
                <h2 class="text-lg font-bold mb-4 text-gray-800">Pencatatan Stok Masuk (Restock)</h2>
                <form id="incoming-form" onsubmit="window.handleIncoming(event)" class="max-w-lg space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Cari Nama Kopi</label>
                        <input type="text" id="incoming-search" onkeyup="window.renderIncomingOptions()" placeholder="Ketik nama kopi untuk memfilter..." class="border p-2 rounded w-full text-sm mb-2">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Pilih Produk</label>
                        <select id="incoming-product" required class="border p-2 rounded w-full text-sm"></select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Jumlah Tambahan (Gram)</label>
                        <input type="number" id="incoming-qty" min="1" required class="border p-2 rounded w-full text-sm" placeholder="Contoh: 1000">
                    </div>
                    <button type="submit" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 rounded text-sm font-bold">Simpan Stok Masuk</button>
                </form>
            </section>

            <!-- TAB 3: STOCK OPNAM -->
            <section id="sec-opnam" class="tab-content hidden bg-white p-5 rounded-lg shadow">
                <h2 class="text-lg font-bold mb-2 text-gray-800">Rekapitulasi Stock Opnam</h2>
                <p class="text-xs text-gray-500 mb-4">Masukkan hasil penimbangan fisik untuk memperbarui persediaan sistem ke Cloud.</p>
                <div class="mb-4">
                    <input type="text" id="opnam-search" onkeyup="window.renderOpnam()" placeholder="Cari item produk untuk stock opnam..." class="border p-2 rounded w-full md:w-1/3 text-sm">
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-gray-100 border-b">
                            <tr>
                                <th class="p-2 border">Nama Produk</th>
                                <th class="p-2 border">Kategori</th>
                                <th class="p-2 border">Stok Sistem (Gram)</th>
                                <th class="p-2 border">Stok Fisik Opnam (Gram)</th>
                                <th class="p-2 border">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="opnam-table-body"></tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 4: MANAJEMEN PELANGGAN -->
            <section id="sec-customers" class="tab-content hidden bg-white p-5 rounded-lg shadow">
                <h2 class="text-lg font-bold mb-4 text-gray-800">Tambah Pelanggan Baru</h2>
                <form id="customer-form" onsubmit="window.handleAddCustomer(event)" class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
                    <input type="text" id="cust-name" required placeholder="Nama Pelanggan" class="border p-2 rounded text-sm">
                    <input type="text" id="cust-phone" required placeholder="Nomor Telepon" class="border p-2 rounded text-sm">
                    <input type="text" id="cust-address" required placeholder="Alamat" class="border p-2 rounded text-sm">
                    <button type="submit" class="md:col-span-3 bg-amber-900 text-white p-2 rounded font-bold text-sm">Tambah Pelanggan</button>
                </form>
                <h3 class="font-bold text-md mb-2">Daftar Pelanggan</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-gray-100 border-b">
                            <tr>
                                <th class="p-2 border">Nama</th>
                                <th class="p-2 border">No. Telp</th>
                                <th class="p-2 border">Alamat</th>
                            </tr>
                        </thead>
                        <tbody id="customer-table-body"></tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 5: HISTORI PENJUALAN -->
            <section id="sec-history" class="tab-content hidden bg-white p-5 rounded-lg shadow">
                <h2 class="text-lg font-bold mb-4 text-gray-800">Histori Transaksi Penjualan</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-gray-100 border-b">
                            <tr>
                                <th class="p-2 border">Invoice</th>
                                <th class="p-2 border">Tanggal</th>
                                <th class="p-2 border">Pelanggan</th>
                                <th class="p-2 border">Total</th>
                                <th class="p-2 border">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="history-table-body"></tbody>
                    </table>
                </div>
            </section>

            <!-- TAB 6: LAPORAN & GRAFIK -->
            <section id="sec-reports" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white p-4 rounded-lg shadow text-center">
                        <span class="text-xs text-gray-500">Total Omset Penjualan</span>
                        <div id="stat-omset" class="text-xl font-bold text-amber-900 mt-1">Rp0</div>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow text-center">
                        <span class="text-xs text-gray-500">Total Transaksi</span>
                        <div id="stat-count" class="text-xl font-bold text-amber-900 mt-1">0</div>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow text-center">
                        <span class="text-xs text-gray-500">Total Kopi Terjual (Gram)</span>
                        <div id="stat-weight" class="text-xl font-bold text-amber-900 mt-1">0 gr</div>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-lg shadow">
                    <h3 class="font-bold mb-4">Grafik Tren Penjualan</h3>
                    <canvas id="salesChart" height="100"></canvas>
                </div>
            </section>

        </main>
    </div>

    <!-- AREA CETAK INVOICE PENJUALAN (PRINTABLE) -->
    <div id="printable-invoice" class="hidden max-w-sm mx-auto bg-white p-4 border text-black">
        <div class="text-center border-b pb-3 mb-3">
            <h2 class="text-xl font-bold uppercase tracking-wider">☕ GENTAN KOPI</h2>
            <p class="text-xs text-gray-600">Jl. Gentan Kopi No. 12, Yogyakarta</p>
            <p class="text-xs text-gray-600">Telp/WA: 0812-3456-7890</p>
        </div>
        
        <div class="text-xs space-y-1 mb-3 border-b pb-2">
            <div class="flex justify-between">
                <span class="text-gray-500">No. Invoice:</span>
                <span id="inv-no" class="font-mono font-bold">INV-000000</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-500">Tanggal:</span>
                <span id="inv-date">-</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-500">Pelanggan:</span>
                <span id="inv-cust" class="font-semibold">-</span>
            </div>
        </div>

        <table class="w-full text-xs text-left mb-3 border-b pb-2">
            <thead>
                <tr class="border-b text-gray-700">
                    <th class="py-1">Item</th>
                    <th class="py-1 text-center">Qty</th>
                    <th class="py-1 text-right">Harga/kg</th>
                    <th class="py-1 text-right">Subtotal</th>
                </tr>
            </thead>
            <tbody id="inv-items" class="divide-y divide-gray-200"></tbody>
        </table>

        <div class="flex justify-between font-bold text-sm pt-1">
            <span>TOTAL BAYAR:</span>
            <span id="inv-total" class="text-base">Rp0</span>
        </div>

        <div class="text-center text-[10px] text-gray-500 mt-5 pt-3 border-t border-dashed">
            <p>Terima kasih atas kunjungan Anda!</p>
            <p>Biji Kopi Segar Nikmat Setiap Hari</p>
        </div>
    </div>

    <!-- Firebase Integration & Logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, updateDoc, onSnapshot, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        let firebaseConfig;
        if (typeof __firebase_config !== 'undefined') {
            firebaseConfig = JSON.parse(__firebase_config);
        } else {
            firebaseConfig = {
                apiKey: "AIzaSyDvuf2uscl_ZoUo6MxSwDOaqb_HwE1rjx0",
                authDomain: "gentan-kopi-pos.firebaseapp.com",
                projectId: "gentan-kopi-pos",
                storageBucket: "gentan-kopi-pos.firebasestorage.app",
                messagingSenderId: "196964586009",
                appId: "1:196964586009:web:6994a641fded25868a9088",
                measurementId: "G-XGE6911MLQ"
            };
        }

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'gentan-kopi-pos';

        let currentUser = null;
        let products = [];
        let customers = [];
        let sales = [];
        let cart = [];
        let chartInstance = null;

        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.error("Gagal Authentikasi: ", err);
                document.getElementById('sync-status').innerText = "Offline Mode (Periksa Kunci Firebase)";
                document.getElementById('sync-status').classList.replace('text-amber-200', 'text-red-300');
            }
        }

        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                document.getElementById('sync-status').innerText = "🟢 Online Tersinkronisasi";
                document.getElementById('sync-status').classList.replace('text-red-300', 'text-green-300');
                setupRealtimeListeners();
            }
        });

        initAuth();

        function setupRealtimeListeners() {
            if (!currentUser) return;

            const productsRef = collection(db, 'artifacts', appId, 'public', 'data', 'products');
            onSnapshot(productsRef, (snapshot) => {
                if (snapshot.empty) {
                    seedDefaultProducts();
                } else {
                    products = snapshot.docs.map(doc => doc.data());
                    products.sort((a, b) => a.category.localeCompare(b.category) || a.name.localeCompare(b.name));
                    window.renderPOSProducts();
                    window.renderIncomingOptions();
                    window.renderOpnam();
                }
            }, (error) => console.error("Error produk:", error));

            const customersRef = collection(db, 'artifacts', appId, 'public', 'data', 'customers');
            onSnapshot(customersRef, (snapshot) => {
                customers = snapshot.docs.map(doc => doc.data());
                window.renderCustomerSelect();
                window.renderCustomers();
            }, (error) => console.error("Error pelanggan:", error));

            const salesRef = collection(db, 'artifacts', appId, 'public', 'data', 'sales');
            onSnapshot(salesRef, (snapshot) => {
                sales = snapshot.docs.map(doc => doc.data());
                sales.sort((a, b) => new Date(b.date) - new Date(a.date));
                window.renderHistory();
                window.renderReports();
            }, (error) => console.error("Error penjualan:", error));
        }

        async function seedDefaultProducts() {
            const defaultProducts = [
                { id: 1, name: "Arabica Bali Kintamani Dark", category: "Local Arabica", price_per_kg: 300000, stock_gram: 0 },
                { id: 2, name: "Arabica Bali Kintamani", category: "Local Arabica", price_per_kg: 300000, stock_gram: 550 }, 
                { id: 3, name: "Arabica Bali Spc.", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 4, name: "Arabica Blue Batak", category: "Local Arabica", price_per_kg: 300000, stock_gram: 400 }, 
                { id: 5, name: "Arabica Carlos Full Wash", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 6, name: "Arabica Cikuray", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 7, name: "Arabica Ciwidey", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 8, name: "Arabica Enrekang", category: "Local Arabica", price_per_kg: 300000, stock_gram: 400 }, 
                { id: 9, name: "Arabica Flores Dark", category: "Local Arabica", price_per_kg: 300000, stock_gram: 0 },
                { id: 10, name: "Arabica Flores Full Wash", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 11, name: "Arabica Garut Nanas", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 12, name: "Arabica Garut Spe.", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 13, name: "Arabica Gayo Esp.", category: "Local Arabica", price_per_kg: 300000, stock_gram: 800 }, 
                { id: 14, name: "Arabica Gayo PR.", category: "Local Arabica", price_per_kg: 300000, stock_gram: 0 },
                { id: 15, name: "Arabica Gayo Spe", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 16, name: "Arabica Ijen Raung", category: "Local Arabica", price_per_kg: 360000, stock_gram: 500 }, 
                { id: 17, name: "Arabica Kerinci Full Wash", category: "Local Arabica", price_per_kg: 380000, stock_gram: 0 },
                { id: 18, name: "Arabica Lintong", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 19, name: "Arabica Longberry", category: "Local Arabica", price_per_kg: 420000, stock_gram: 0 },
                { id: 20, name: "Arabica Malabar", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 21, name: "Arabica Malino Spc.", category: "Local Arabica", price_per_kg: 400000, stock_gram: 0 },
                { id: 22, name: "Arabica Mandailing", category: "Local Arabica", price_per_kg: 300000, stock_gram: 800 }, 
                { id: 23, name: "Arabica Mandailing Spc.", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 24, name: "Arabica Manggarai", category: "Local Arabica", price_per_kg: 360000, stock_gram: 500 }, 
                { id: 25, name: "Arabica Manglayang", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 26, name: "Arabica Mekar Wangi", category: "Local Arabica", price_per_kg: 360000, stock_gram: 500 }, 
                { id: 27, name: "Arabica Papua Dark", category: "Local Arabica", price_per_kg: 400000, stock_gram: 0 },
                { id: 28, name: "Arabica Papua Wamena", category: "Local Arabica", price_per_kg: 400000, stock_gram: 0 },
                { id: 29, name: "Arabica Pieberry", category: "Local Arabica", price_per_kg: 420000, stock_gram: 0 },
                { id: 30, name: "Arabica Puntang Full Wash", category: "Local Arabica", price_per_kg: 400000, stock_gram: 0 },
