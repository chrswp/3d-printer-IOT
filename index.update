                { id: 33, name: "Arabica Sidikalang PR.", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
                { id: 34, name: "Arabica Sigararutang", category: "Local Arabica", price_per_kg: 360000, stock_gram: 0 },
